{
  "name": "@pca/cloud-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "start": "tsx src/migrate.ts && tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/test/*.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "@hono/node-server": "^2.0.12",
    "@pca/contracts": "workspace:*",
    "@pca/db-cloud": "workspace:*",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "pg": "8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.15.6",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
