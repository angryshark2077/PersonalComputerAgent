{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personalcomputeragent.local/contracts/agent-control-snapshot.schema.json",
  "title": "AgentControlSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "workspace_id",
    "revoked",
    "configuration_revision",
    "collectors"
  ],
  "properties": {
    "device_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "revoked": { "type": "boolean" },
    "configuration_revision": { "type": "integer", "minimum": 0 },
    "local_media_cleanup": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_id"],
          "properties": { "request_id": { "type": "string", "format": "uuid" } }
        },
        { "type": "null" }
      ]
    },
    "screenshot_request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_id"],
          "properties": { "request_id": { "type": "string", "format": "uuid" } }
        },
        { "type": "null" }
      ]
    },
    "collectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "screen.capture", "communication.wechat", "communication.messages", "photos.library"],
      "properties": {
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "screen.capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "scheduled_enabled", "interval_seconds", "activity_enabled", "activity_min_interval_seconds", "excluded_bundle_ids"],
          "properties": {
            "enabled": { "type": "boolean" },
            "scheduled_enabled": { "type": "boolean" },
            "interval_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
            "activity_enabled": { "type": "boolean" },
            "activity_min_interval_seconds": { "type": "integer", "minimum": 10, "maximum": 3600 },
            "excluded_bundle_ids": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9.-]+$" }
            }
          }
        },
        "communication.wechat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "directions",
            "message_types",
            "conversation_scope",
            "max_group_members",
            "sync_mode",
            "retention_days"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "directions": {
              "type": "array",
              "prefixItems": [{ "const": "incoming" }, { "const": "outgoing" }],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "message_types": {
              "type": "array",
              "prefixItems": [
                { "const": "text" },
                { "const": "audio" },
                { "const": "image" },
                { "const": "video" }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            },
            "conversation_scope": { "const": "direct_and_group_at_most_fifteen_members" },
            "max_group_members": { "const": 15 },
            "sync_mode": { "const": "full" },
            "retention_days": { "const": 180 }
          }
        },
        "communication.messages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "directions", "message_types", "conversation_scope", "initial_lookback_days", "sync_mode", "attachments_enabled", "attachment_retention_days"],
          "properties": {
            "enabled": { "type": "boolean" },
            "directions": {
              "type": "array",
              "prefixItems": [{ "const": "incoming" }, { "const": "outgoing" }],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "message_types": {
              "type": "array",
              "prefixItems": [{ "const": "text" }],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            },
            "conversation_scope": { "const": "all" },
            "initial_lookback_days": { "const": 7 },
            "sync_mode": { "const": "full" },
            "attachments_enabled": { "const": false },
            "attachment_retention_days": { "const": 7 }
          }
        },
        "photos.library": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "media_types", "include_originals", "include_album_names", "initial_lookback_days", "cloud_retention"],
          "properties": {
            "enabled": { "type": "boolean" },
            "media_types": {
              "type": "array",
              "prefixItems": [{ "const": "image" }, { "const": "video" }],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "include_originals": { "const": true },
            "include_album_names": { "const": true },
            "initial_lookback_days": { "const": 60 },
            "cloud_retention": { "const": "permanent" }
          }
        }
      }
    }
  }
}
