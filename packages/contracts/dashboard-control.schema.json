{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pca.local/contracts/dashboard-control.schema.json",
  "title": "DashboardControl",
  "oneOf": [
    { "$ref": "#/$defs/WorkspaceList" },
    { "$ref": "#/$defs/DeviceList" },
    { "$ref": "#/$defs/DeviceDetail" },
    { "$ref": "#/$defs/AuditList" }
  ],
  "$defs": {
    "CollectorConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "communication.wechat"],
      "properties": {
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "communication.wechat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "directions",
            "message_types",
            "conversation_scope",
            "max_group_members",
            "sync_mode",
            "retention_days"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "directions": {
              "type": "array",
              "prefixItems": [{ "const": "incoming" }, { "const": "outgoing" }],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "message_types": {
              "type": "array",
              "prefixItems": [
                { "const": "text" },
                { "const": "audio" },
                { "const": "image" },
                { "const": "video" }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            },
            "conversation_scope": { "const": "direct_and_group_at_most_fifteen_members" },
            "max_group_members": { "const": 15 },
            "sync_mode": { "const": "full" },
            "retention_days": { "const": 180 }
          }
        }
      }
    },
    "DeviceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence", "agent_version", "outbox_depth", "local_media", "network", "observed_at"],
      "properties": {
        "presence": { "enum": ["online", "stale", "offline", "sleeping"] },
        "agent_version": { "type": "string", "minLength": 1 },
        "outbox_depth": { "type": "integer", "minimum": 0 },
        "local_media": { "$ref": "#/$defs/LocalMedia" },
        "network": { "anyOf": [{ "$ref": "#/$defs/NetworkStatus" }, { "type": "null" }] },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "NetworkStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_type", "wifi_identity_available", "ssid", "bssid", "local_ipv4", "local_ipv6", "public_ip", "ip_location", "matched_location"],
      "properties": {
        "interface_type": { "enum": ["wifi", "wired", "other", "none"] },
        "wifi_identity_available": { "type": "boolean" },
        "ssid": { "type": ["string", "null"] },
        "bssid": { "type": ["string", "null"] },
        "local_ipv4": { "type": ["string", "null"] },
        "local_ipv6": { "type": ["string", "null"] },
        "public_ip": { "type": ["string", "null"] },
        "ip_location": { "anyOf": [{ "type": "object", "additionalProperties": false, "required": ["country", "region", "city", "accuracy"], "properties": { "country": { "type": ["string", "null"] }, "region": { "type": ["string", "null"] }, "city": { "type": ["string", "null"] }, "accuracy": { "const": "ip_city" } } }, { "type": "null" }] },
        "matched_location": { "anyOf": [{ "$ref": "#/$defs/NetworkLocation" }, { "type": "null" }] }
      }
    },
    "NetworkLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_id", "name", "match_ssid", "match_bssid", "country", "region", "city", "created_at", "updated_at"],
      "properties": {
        "location_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "match_ssid": { "type": ["string", "null"] },
        "match_bssid": { "type": ["string", "null"] },
        "country": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "LocalMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_file_count", "completed_bytes", "protected_file_count", "protected_bytes"],
      "properties": {
        "completed_file_count": { "type": "integer", "minimum": 0 },
        "completed_bytes": { "type": "integer", "minimum": 0 },
        "protected_file_count": { "type": "integer", "minimum": 0 },
        "protected_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "LocalMediaCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "status", "requested_at", "completed_at", "deleted_file_count", "freed_bytes", "error_code"],
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "status": { "enum": ["queued", "succeeded", "failed"] },
        "requested_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "deleted_file_count": { "type": ["integer", "null"], "minimum": 0 },
        "freed_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "error_code": { "type": ["string", "null"] }
      }
    },
    "DeviceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "workspace_id", "platform", "paired_at", "revoked", "configuration_revision", "status"],
      "properties": {
        "device_id": { "type": "string", "format": "uuid" },
        "workspace_id": { "type": "string", "format": "uuid" },
        "platform": { "const": "macos" },
        "paired_at": { "type": "string", "format": "date-time" },
        "revoked": { "type": "boolean" },
        "configuration_revision": { "type": "integer", "minimum": 0 },
        "status": {
          "anyOf": [{ "$ref": "#/$defs/DeviceStatus" }, { "type": "null" }]
        }
      }
    },
    "DeviceDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "workspace_id", "platform", "paired_at", "revoked", "configuration_revision", "status", "collectors", "local_media_cleanup"],
      "properties": {
        "device_id": { "type": "string", "format": "uuid" },
        "workspace_id": { "type": "string", "format": "uuid" },
        "platform": { "const": "macos" },
        "paired_at": { "type": "string", "format": "date-time" },
        "revoked": { "type": "boolean" },
        "configuration_revision": { "type": "integer", "minimum": 0 },
        "status": {
          "anyOf": [{ "$ref": "#/$defs/DeviceStatus" }, { "type": "null" }]
        },
        "collectors": { "$ref": "#/$defs/CollectorConfig" },
        "local_media_cleanup": {
          "anyOf": [{ "$ref": "#/$defs/LocalMediaCleanup" }, { "type": "null" }]
        }
      }
    },
    "WorkspaceList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaces"],
      "properties": {
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workspace_id", "name"],
            "properties": {
              "workspace_id": { "type": "string", "format": "uuid" },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "DeviceList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devices"],
      "properties": {
        "devices": { "type": "array", "items": { "$ref": "#/$defs/DeviceSummary" } }
      }
    },
    "AuditList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit"],
      "properties": {
        "audit": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_user_id", "configuration_revision", "old_config", "new_config", "created_at"],
            "properties": {
              "actor_user_id": { "type": "string", "format": "uuid" },
              "configuration_revision": { "type": "integer", "minimum": 1 },
              "old_config": { "$ref": "#/$defs/CollectorConfig" },
              "new_config": { "$ref": "#/$defs/CollectorConfig" },
              "created_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
