{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personalcomputeragent.local/contracts/event-envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "workspace_id",
    "device_id",
    "event_type",
    "source",
    "schema_version",
    "occurred_at",
    "created_at",
    "sensitivity",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sensitivity": {
      "enum": [
        "public",
        "normal",
        "medium",
        "high",
        "secret"
      ]
    },
    "payload": {
      "type": "object"
    },
    "attachment_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  }
}
