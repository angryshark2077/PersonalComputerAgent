{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personalcomputeragent.local/contracts/agent-control-snapshot.schema.json",
  "title": "AgentControlSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "workspace_id",
    "revoked",
    "configuration_revision",
    "collectors"
  ],
  "properties": {
    "device_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "revoked": { "type": "boolean" },
    "configuration_revision": { "type": "integer", "minimum": 0 },
    "collectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "communication.wechat"],
      "properties": {
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "communication.wechat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "directions",
            "message_types",
            "conversation_scope",
            "max_group_members",
            "sync_mode",
            "retention_days"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "directions": {
              "type": "array",
              "prefixItems": [{ "const": "incoming" }, { "const": "outgoing" }],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "message_types": {
              "type": "array",
              "prefixItems": [
                { "const": "text" },
                { "const": "audio" },
                { "const": "image" },
                { "const": "video" }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            },
            "conversation_scope": { "const": "direct_and_group_at_most_eight_members" },
            "max_group_members": { "const": 8 },
            "sync_mode": { "const": "full" },
            "retention_days": { "const": 180 }
          }
        }
      }
    }
  }
}
